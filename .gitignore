# Provenance logs (runtime, per-run, regenerable)
provenance/

# Session data (user-specific, large)
sessions/*.json
sessions/*.duckdb
sessions/*.duckdb.wal

# Registry data (runtime, regenerable)
sessions/registry/

# Temp diagnostic files
_*
!_archive/
!__init__.py

# Archive data (large, not code)
_archive/data/

# Topology data (derived from sessions, regenerable)
topology/*.json

# Session transcripts (runtime, regenerable)
_raw_transcripts.json
_raw_transcripts_latest.json

# HTML output (generated, regenerable)
e0_communication.html
e0_session_*.html
