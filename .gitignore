*.safetensors
.cache/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vscode/
*.swp

# Node.js (client)
node_modules/

# Experiment results (large, regenerable)
experiments/results/

# Secrets
.env

# Bootstrap context (local AI session state)
bootstrap.json

# MemOS runtime data (generated per-run, large)
memos/runs/
memos/sessions/
memos/_beipackzettel/
memos/_burnout/
memos/_burnout_iterate/
memos/_demo_persist/
memos/_ezb/
